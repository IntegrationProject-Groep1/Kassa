# Odoo configuratie
ODOO_URL=<your_odoo_url>
ODOO_DB=<your_odoo_db>
ODOO_USER=<your_odoo_username>
ODOO_PASS=<your_odoo_password>
ODOO_MASTER_PASS=<your_odoo_master_password>

# Postgres configuratie
POSTGRES_USER=<your_postgres_username>
POSTGRES_PASSWORD=<your_postgres_password>

# RabbitMQ configuratie
# Lokaal (docker compose): RABBIT_HOST=rabbitmq, RABBIT_PORT=5672
# Gedeelde Infra RabbitMQ:  RABBIT_HOST=<infra-server>, RABBIT_PORT=30000
RABBIT_USER=<your_rabbitmq_username>
RABBIT_PASS=<your_rabbitmq_password>
RABBIT_PORT=<5672_lokaal_of_30000_infra>
RABBIT_EXCHANGE=<your_rabbitmq_exchange>

# Integratie instellingen
POLL_INTERVAL=<poll_interval_in_seconds>
