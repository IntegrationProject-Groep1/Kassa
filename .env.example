# Example environment variables for local / staging deployments
RABBIT_HOST=localhost
RABBIT_USER=guest
RABBIT_PASS=guest
RABBIT_VHOST=/
RABBIT_INCOMING_QUEUE=kassa.incoming

# Odoo
ODOO_URL=http://odoo:8069
ODOO_DB=odoo_db
ODOO_USER=admin
ODOO_PASS=admin

# Identity Service routing keys (optional override)
IDENTITY_ROUTING_KEY_CREATE=identity.user.create.request
IDENTITY_ROUTING_KEY_LOOKUP_EMAIL=identity.user.lookup.email.request
IDENTITY_ROUTING_KEY_LOOKUP_UUID=identity.user.lookup.uuid.request

# Subscribe to user.events fanout? Set true in staging when minimal notifications are required.
SUBSCRIBE_USER_EVENTS=false
# ============================================================
# .env.example — kopieer dit bestand naar .env en vul in.
# Commit NOOIT het echte .env-bestand — het staat in .gitignore.
# ============================================================

# --- ODOO CONFIGURATIE ---
# Pin Odoo versie om onverwachte major upgrades van ':latest' te vermijden
ODOO_IMAGE=odoo:17.0
ODOO_URL=<your_odoo_url>
ODOO_DB=<your_odoo_db>
ODOO_USER=<your_odoo_username>
ODOO_PASS=<your_odoo_password>
# Sterke master wachtwoord — beschermt de 'Manage Databases' pagina (aanmaken/verwijderen DB)
# Gebruik een willekeurig gegenereerd wachtwoord, bv: openssl rand -base64 32
ODOO_MASTER_PASS=<your_odoo_master_password>
# Zet op 'true' om DB met Odoo demo data te maken (niet voor productie)
ODOO_LOAD_DEMO_DATA=false

# --- POSTGRES DATABASE (voor de Odoo container) ---
POSTGRES_USER=<your_postgres_username>
POSTGRES_PASSWORD=<your_postgres_password>
POSTGRES_DB=postgres

# --- RABBITMQ CONFIGURATIE ---
# Lokaal (docker compose): RABBIT_HOST=rabbitmq, RABBIT_PORT=5672
# Gedeelde Infra RabbitMQ:  RABBIT_HOST=<infra-server>, RABBIT_PORT=30000
RABBIT_HOST=<your_rabbitmq_host>
RABBIT_PORT=<your_rabbitmq_port>
RABBIT_USER=<your_rabbitmq_username>
RABBIT_PASS=<your_rabbitmq_password>
RABBIT_VHOST=/
RABBIT_EXCHANGE=kassa.exchange
RABBIT_INCOMING_QUEUE=kassa.incoming
RABBIT_PLANNING_EXCHANGE=planning.exchange

# Dead Letter Queue instellingen
# BELANGRIJK: Op gedeelde Azure-server (infra): zet RABBIT_DLX=kassa.dlx
#            (De queue bestaat al daar met die DLX; zie Error 406 PRECONDITION_FAILED)
# Voor lokaal development: RABBIT_DLX=kassa.exchange (standaard)
RABBIT_DLX=kassa.exchange
RABBIT_DLQ=kassa.incoming.dlq
RABBIT_DLX_ROUTING_KEY=kassa.incoming.dlq

# --- INTEGRATIE INSTELLINGEN ---
# Hoe vaak de poller Odoo scant op nieuwe orders (in seconden)
POLL_INTERVAL=3
# De exacte naam van de betaalmethode in Odoo POS
BADGE_PAYMENT_METHOD_NAME="Badge Wallet"
