<?xml version="1.0" encoding="UTF-8"?>
<!-- schema_profiel_update.xsd – v2.0                               -->
<!-- Team Kassa | Integratieproject Desideriushogeschool 2026        -->
<!-- Flow 3: profile_update – update existing customer profile       -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:complexType name="HeaderType">
    <xs:sequence>
      <xs:element name="message_id" type="xs:string"/>
      <xs:element name="type"       type="xs:string" fixed="profile_update"/>
      <xs:element name="source"     type="xs:string"/>
      <xs:element name="timestamp"  type="xs:dateTime"/>
      <xs:element name="version"    type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="message">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="header" type="HeaderType"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="user_id"      type="xs:string"/>
              <xs:element name="email"        type="xs:string"  minOccurs="0"/>
              <xs:element name="name"         type="xs:string"  minOccurs="0"/>
              <xs:element name="company_name" type="xs:string"  minOccurs="0"/>
              <xs:element name="age"          type="xs:integer" minOccurs="0"/>
              <xs:element name="type"         minOccurs="0">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="company"/>
                    <xs:enumeration value="private"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="vat_number" type="xs:string" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
