<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        Story 21 — Outstanding amount badge in the partner list.
        Extends PartnerLine to show a warning badge when a customer has an
        unpaid registration amount.  The badge is rendered below the partner
        name, before the existing email/phone info so it is clearly visible.

        kassaHasOutstanding / kassaOutstandingAmount / kassaPaymentStatus are
        computed getters added via the PartnerLine patch in pos_custom.js.
    -->
    <t t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension">
        <xpath expr="//td[1]/b" position="after">
            <t t-if="kassaIsRecentlyScanned or kassaSessionTitles.length > 0 or kassaHasOutstanding or kassaHasWallet">
                <div class="kassa-outstanding-info d-flex gap-1 mt-1 flex-wrap">
                    <t t-if="kassaIsRecentlyScanned">
                        <span class="badge bg-primary">Recent</span>
                    </t>
                    <t t-foreach="kassaSessionTitles" t-as="sessionTitle" t-key="sessionTitle">
                        <span class="badge bg-info text-dark">
                            <t t-esc="sessionTitle"/>
                        </span>
                    </t>
                    <t t-if="kassaHasOutstanding">
                        <span class="badge bg-warning text-dark">
                            Openstaand: €<t t-esc="kassaOutstandingAmount"/>
                        </span>
                        <span
                            t-if="kassaPaymentStatus === 'unpaid'"
                            class="badge bg-danger"
                        >
                            Onbetaald
                        </span>
                    </t>
                    <t t-if="kassaHasWallet">
                        <span t-att-class="'badge ' + ((props.partner.x_wallet_balance || 0) > 0 ? 'bg-success' : 'bg-secondary')">
                            Wallet: €<t t-esc="kassaWalletBalance"/>
                        </span>
                    </t>
                </div>
            </t>
        </xpath>
    </t>


    <!--
        Wallet strip on the product screen — injected directly above the
        control-buttons row (Refund / Customer Note / Scan QR) inside
        ActionpadWidget, so it sits between the Total and the action tabs.
        Renders as a compact horizontal bar with wallet and outstanding badges
        side by side.
    -->
    <t t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons')]" position="before">
            <t t-set="kassaPartner" t-value="currentOrder.get_partner()"/>
            <t t-set="kassaBalance" t-value="kassaPartner &amp;&amp; (kassaPartner.x_wallet_balance || 0)"/>
            <t t-set="kassaLeaseActivating" t-value="kassaPartner &amp;&amp; kassaPartner.x_lease_active &amp;&amp; !kassaPartner.x_lease_id"/>
            <t t-if="kassaLeaseActivating">
                <div class="kassa-wallet-strip d-flex align-items-center gap-2 px-2 py-1 bg-warning-subtle text-warning-emphasis border-bottom border-warning small fw-semibold">
                    <i class="fa fa-spinner fa-spin"/>
                    Wallet wordt geactiveerd...
                </div>
            </t>
            <t t-elif="kassaPartner &amp;&amp; kassaPartner.x_lease_active &amp;&amp; kassaPartner.x_lease_id">
                <t t-set="kassaSufficient" t-value="Math.round((kassaBalance || 0) * 100) >= Math.round((currentOrder.get_due() || 0) * 100)"/>
                <div class="kassa-wallet-strip d-flex align-items-center gap-2 px-2 py-1 border-bottom small">
                    <i class="fa fa-credit-card text-muted"/>
                    <span t-att-class="'badge fw-semibold ' + (kassaSufficient ? 'bg-success' : 'bg-danger')">
                        Wallet €<t t-esc="(kassaBalance || 0).toFixed(2)"/>
                    </span>
                    <t t-if="!kassaSufficient">
                        <span class="text-danger fw-semibold">Onvoldoende saldo</span>
                    </t>
                    <t t-if="(kassaPartner.x_outstanding_amount || 0) > 0">
                        <span class="badge bg-warning text-dark fw-semibold">
                            Openstaand €<t t-esc="(kassaPartner.x_outstanding_amount || 0).toFixed(2)"/>
                        </span>
                    </t>
                </div>
            </t>
        </xpath>
    </t>

    <!--
        Wallet strip on the payment screen — shown as a compact info bar
        at the top of the payment buttons area.
        Green border = wallet sufficient; red border = insufficient.
    -->
    <t t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-buttons')]" position="inside">
            <t t-set="kassaPartner" t-value="currentOrder.get_partner()"/>
            <t t-set="kassaBalance" t-value="kassaPartner &amp;&amp; (kassaPartner.x_wallet_balance || 0)"/>
            <t t-set="kassaLeaseActivating" t-value="kassaPartner &amp;&amp; kassaPartner.x_lease_active &amp;&amp; !kassaPartner.x_lease_id"/>
            <t t-if="kassaLeaseActivating">
                <div class="kassa-wallet-strip d-flex align-items-center gap-2 px-2 py-2 mb-2 rounded bg-warning-subtle text-warning-emphasis border border-warning small fw-semibold">
                    <i class="fa fa-spinner fa-spin"/>
                    Wallet wordt geactiveerd...
                </div>
            </t>
            <t t-elif="kassaPartner &amp;&amp; kassaPartner.x_lease_active &amp;&amp; kassaPartner.x_lease_id">
                <t t-set="kassaSufficient" t-value="Math.round((kassaBalance || 0) * 100) >= Math.round((currentOrder.get_due() || 0) * 100)"/>
                <div t-att-class="'kassa-wallet-strip d-flex align-items-center justify-content-between gap-2 px-3 py-2 mb-2 rounded fw-semibold ' + (kassaSufficient ? 'bg-success-subtle text-success-emphasis border border-success' : 'bg-danger-subtle text-danger-emphasis border border-danger')">
                    <span>
                        <i class="fa fa-credit-card me-1"/>
                        Wallet €<t t-esc="(kassaBalance || 0).toFixed(2)"/>
                    </span>
                    <t t-if="(kassaPartner.x_outstanding_amount || 0) > 0">
                        <span class="badge bg-warning text-dark">
                            Openstaand €<t t-esc="(kassaPartner.x_outstanding_amount || 0).toFixed(2)"/>
                        </span>
                    </t>
                    <t t-if="!kassaSufficient">
                        <span class="small fw-normal">Onvoldoende saldo</span>
                    </t>
                </div>
            </t>
        </xpath>
    </t>

    <!--
        Hide Badge Wallet button when no customer is selected or when the
        customer's wallet balance is insufficient to cover the remaining order total.
    -->
    <t t-inherit="point_of_sale.PaymentScreenMethods" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('paymentmethod')]" position="attributes">
            <attribute name="t-if">paymentMethod.name !== 'Badge Wallet' || (currentOrder.get_partner() &amp;&amp; currentOrder.get_partner().x_lease_active &amp;&amp; currentOrder.get_partner().x_lease_id &amp;&amp; Math.round((currentOrder.get_partner().x_wallet_balance || 0) * 100) >= Math.round((currentOrder.get_due() || 0) * 100))</attribute>
        </xpath>
    </t>

    <!--
        VAT prompt dialog — shown when a private customer enables invoice
        without having a VAT number on file.
        Cashier enters the number to proceed, or clicks "Factuur annuleren" to
        clear the invoice flag and complete the order as a normal sale.
    -->
    <t t-name="kassa_pos_custom.VatPromptDialog">
        <Dialog title="'BTW-nummer vereist'">
            <p>
                Klant <b t-esc="props.partnerName"/> heeft geen BTW-nummer.
            </p>
            <p>
                Voer het BTW-nummer in om door te gaan, of annuleer de factuur.
            </p>
            <div class="mb-3">
                <input
                    type="text"
                    class="form-control"
                    placeholder="BE0123456789"
                    t-model="state.vatNumber"
                    t-on-keyup.enter="confirm"
                    autofocus="autofocus"
                />
                <t t-if="state.error">
                    <div class="text-danger small mt-1" t-esc="state.error"/>
                </t>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="confirm">Bevestigen</button>
                <button class="btn btn-secondary ms-2" t-on-click="cancel">Factuur annuleren</button>
            </t>
        </Dialog>
    </t>

</templates>
