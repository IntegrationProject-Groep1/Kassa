<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        Story 21 — Outstanding amount badge in the partner list.
        Extends PartnerLine to show a warning badge when a customer has an
        unpaid registration amount.  The badge is rendered below the partner
        name, before the existing email/phone info so it is clearly visible.

        kassaHasOutstanding / kassaOutstandingAmount / kassaPaymentStatus are
        computed getters added via the PartnerLine patch in pos_custom.js.
    -->
    <t t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension">
        <xpath expr="//td[1]/b" position="after">
            <t t-if="kassaIsRecentlyScanned or kassaSessionTitles.length > 0 or kassaHasOutstanding or kassaHasWallet">
                <div class="kassa-outstanding-info d-flex gap-1 mt-1 flex-wrap">
                    <t t-if="kassaIsRecentlyScanned">
                        <span class="badge bg-primary">Recent</span>
                    </t>
                    <t t-foreach="kassaSessionTitles" t-as="sessionTitle" t-key="sessionTitle">
                        <span class="badge bg-info text-dark">
                            <t t-esc="sessionTitle"/>
                        </span>
                    </t>
                    <t t-if="kassaHasOutstanding">
                        <span class="badge bg-warning text-dark">
                            Openstaand: €<t t-esc="kassaOutstandingAmount"/>
                        </span>
                        <span
                            t-if="kassaPaymentStatus === 'unpaid'"
                            class="badge bg-danger"
                        >
                            Onbetaald
                        </span>
                    </t>
                    <t t-if="kassaHasWallet">
                        <span t-att-class="'badge ' + ((props.partner.x_wallet_balance || 0) > 0 ? 'bg-success' : 'bg-secondary')">
                            Wallet: €<t t-esc="kassaWalletBalance"/>
                        </span>
                    </t>
                </div>
            </t>
        </xpath>
    </t>


    <!--
        Story 19 — Hide Badge Wallet when no customer is linked to the order.
        OWL re-evaluates currentOrder.get_partner() reactively whenever the
        partner changes, so the button appears/disappears without a page reload.
    -->
    <!--
        Wallet balance notification shown next to the customer name on the payment screen.
        Stays visible as long as a Kassa visitor is selected.
        Green = sufficient balance; red = insufficient (Badge Wallet button is also hidden).
    -->
    <t t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-buttons')]" position="inside">
            <t t-set="kassaBalance" t-value="currentOrder.partner_id &amp;&amp; (currentOrder.partner_id.x_wallet_balance || 0)"/>
            <t t-if="kassaBalance > 0">
                <t t-set="kassaSufficient" t-value="Math.round(kassaBalance * 100) >= Math.round((currentOrder.get_due() || 0) * 100)"/>
                <div t-att-class="'kassa-wallet-notification mt-1 p-2 rounded text-center fw-bold ' + (kassaSufficient ? 'bg-success-subtle text-success-emphasis border border-success' : 'bg-danger-subtle text-danger-emphasis border border-danger')">
                    <i class="fa fa-credit-card me-1"/>
                    Wallet: €<t t-esc="kassaBalance.toFixed(2)"/>
                    <t t-if="!kassaSufficient">
                        <span class="d-block small fw-normal">Onvoldoende saldo</span>
                    </t>
                </div>
            </t>
        </xpath>
    </t>

    <!--
        Wallet balance notification on the product screen, above the Customer/Payment buttons.
        Visible from the moment a Kassa visitor is selected until they pay or are deselected.
    -->
    <t t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//ActionpadWidget" position="before">
            <t t-set="kassaBalance" t-value="currentOrder.partner_id &amp;&amp; (currentOrder.partner_id.x_wallet_balance || 0)"/>
            <t t-if="kassaBalance > 0">
                <t t-set="kassaSufficient" t-value="Math.round(kassaBalance * 100) >= Math.round((currentOrder.get_due() || 0) * 100)"/>
                <div t-att-class="'kassa-wallet-notification p-2 rounded text-center fw-bold ' + (kassaSufficient ? 'bg-success-subtle text-success-emphasis border border-success' : 'bg-danger-subtle text-danger-emphasis border border-danger')">
                    <i class="fa fa-credit-card me-1"/>
                    Wallet: €<t t-esc="kassaBalance.toFixed(2)"/>
                    <t t-if="!kassaSufficient">
                        <span class="d-block small fw-normal">Onvoldoende saldo</span>
                    </t>
                </div>
            </t>
        </xpath>
    </t>

    <!--
        Hide Badge Wallet button when no customer is selected or when the
        customer's wallet balance is insufficient to cover the remaining order total.
    -->
    <t t-inherit="point_of_sale.PaymentScreenMethods" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('paymentmethod')]" position="attributes">
            <attribute name="t-if">paymentMethod.name !== 'Badge Wallet' || (currentOrder.partner_id &amp;&amp; currentOrder.partner_id.x_lease_active &amp;&amp; currentOrder.partner_id.x_lease_id &amp;&amp; Math.round((currentOrder.partner_id.x_wallet_balance || 0) * 100) >= Math.round((currentOrder.get_due() || 0) * 100))</attribute>
        </xpath>
    </t>

    <!--
        VAT prompt dialog — shown when a private customer enables invoice
        without having a VAT number on file.
        Cashier enters the number to proceed, or clicks "Factuur annuleren" to
        clear the invoice flag and complete the order as a normal sale.
    -->
    <t t-name="kassa_pos_custom.VatPromptDialog">
        <Dialog title="'BTW-nummer vereist'">
            <p>
                Klant <b t-esc="props.partnerName"/> heeft geen BTW-nummer.
            </p>
            <p>
                Voer het BTW-nummer in om door te gaan, of annuleer de factuur.
            </p>
            <div class="mb-3">
                <input
                    type="text"
                    class="form-control"
                    placeholder="BE0123456789"
                    t-model="state.vatNumber"
                    t-on-keyup.enter="confirm"
                    autofocus="autofocus"
                />
                <t t-if="state.error">
                    <div class="text-danger small mt-1" t-esc="state.error"/>
                </t>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="confirm">Bevestigen</button>
                <button class="btn btn-secondary ms-2" t-on-click="cancel">Factuur annuleren</button>
            </t>
        </Dialog>
    </t>

</templates>
