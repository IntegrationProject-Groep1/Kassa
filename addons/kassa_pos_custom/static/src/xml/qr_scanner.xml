<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="kassa_pos_custom.QrScanButton">
        <!-- Trigger button on the POS product screen -->
        <button class="btn btn-secondary control-button" t-on-click="openScanner">
            <i class="fa fa-qrcode me-1"/>
            Scan QR
        </button>

        <!-- Overlay portalled to document.body (via onMounted in JS) to escape POS CSS transforms -->
        <div t-ref="overlay" t-att-style="state.open ?
            'position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.85);display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding-top:8vh;' :
            'display:none;'
        ">
                <!-- Video container -->
                <div style="position:relative; width:min(90vw,640px);">
                    <video
                        t-ref="video"
                        autoplay="autoplay"
                        playsinline="playsinline"
                        muted="muted"
                        style="width:100%;border-radius:8px;display:block;background:#000;"
                    />
                    <!-- Scan-zone guide box -->
                    <t t-if="state.phase === 'scanning'">
                        <div style="
                            position:absolute;
                            top:50%; left:50%;
                            transform:translate(-50%,-50%);
                            width:55%; aspect-ratio:1/1;
                            border: 3px solid #28a745;
                            border-radius: 8px;
                            pointer-events: none;
                        "/>
                    </t>
                </div>

                <!-- Status message -->
                <div style="margin-top:16px; font-weight:600; font-size:1rem;"
                     t-att-style="state.phase === 'error' ? 'color:#dc3545;' : 'color:#fff;'"
                     t-esc="state.message"
                />

                <!-- Spinner while processing -->
                <t t-if="state.phase === 'processing'">
                    <div class="spinner-border text-light mt-3" role="status"/>
                </t>

                <!-- Cancel button -->
                <button class="btn btn-outline-light mt-4" t-on-click="cancel">
                    Annuleren
                </button>
            </div>
    </t>

</templates>
