<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="kassa_pos_custom.QrScanButton">
        <button class="btn btn-secondary control-button" t-on-click="openScanner">
            <i class="fa fa-qrcode me-1"/>
            Scan QR
        </button>
    </t>

    <t t-name="kassa_pos_custom.QrScannerModal">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">QR-code scannen</h5>
                    <button type="button" class="btn-close btn-close-white" t-on-click="cancel"/>
                </div>
                <div class="modal-body bg-dark d-flex flex-column align-items-center p-3">
                    <div class="position-relative" style="max-width:640px;width:100%">
                        <video
                            t-ref="video"
                            autoplay="autoplay"
                            playsinline="playsinline"
                            muted="muted"
                            style="width:100%;border-radius:8px;display:block"
                        />
                        <t t-if="state.phase === 'scanning'">
                            <div
                                class="position-absolute border border-3 border-success rounded"
                                style="
                                    top:50%;left:50%;
                                    transform:translate(-50%,-50%);
                                    width:55%;aspect-ratio:1/1;
                                    pointer-events:none;
                                "
                            />
                        </t>
                    </div>
                    <div
                        class="mt-3 text-center fw-semibold"
                        t-att-class="state.phase === 'error' ? 'text-danger' : 'text-white'"
                        t-esc="state.message"
                    />
                    <t t-if="state.phase === 'processing'">
                        <div class="spinner-border text-light mt-3" role="status"/>
                    </t>
                </div>
                <div class="modal-footer bg-dark border-top border-secondary">
                    <button class="btn btn-outline-light" t-on-click="cancel">Annuleren</button>
                </div>
            </div>
        </div>
    </t>

</templates>
