[options]
; Master password for the Manage Databases page — must match ODOO_MASTER_PASS in .env
admin_passwd = <your_odoo_master_password>
db_host = kassa-db
db_port = 5432
addons_path = /mnt/extra-addons
data_dir = /var/lib/odoo
; Suppress per-request XML-RPC access logs — keeps kassa-web logs readable
log_handler = werkzeug:WARNING
