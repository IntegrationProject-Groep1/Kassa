RABBIT_HOST=rabbitmq.staging.internal
RABBIT_USER=staging_user
RABBIT_PASS=staging_pass
RABBIT_VHOST=/
RABBIT_INCOMING_QUEUE=kassa.incoming

ODOO_URL=https://odoo.staging.internal
ODOO_DB=staging_db
ODOO_USER=staging_user
ODOO_PASS=staging_pass

IDENTITY_ROUTING_KEY_CREATE=identity.user.create.request
IDENTITY_ROUTING_KEY_LOOKUP_EMAIL=identity.user.lookup.email.request
IDENTITY_ROUTING_KEY_LOOKUP_UUID=identity.user.lookup.uuid.request

# In staging we enable minimal subscription to user.events fanout for notifications
SUBSCRIBE_USER_EVENTS=true
